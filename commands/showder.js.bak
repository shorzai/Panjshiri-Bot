import fs from "fs";

const showderFile = "./data/showder.json";

const OWNER = "93794384087@s.whatsapp.net";


function load(){

if(!fs.existsSync(showderFile)){

fs.mkdirSync("./data",{recursive:true});

fs.writeFileSync(
showderFile,
JSON.stringify({
private:{},
group:{},
_status:true
},null,2)
);

}

return JSON.parse(
fs.readFileSync(showderFile)
);

}



function save(data){

fs.writeFileSync(
showderFile,
JSON.stringify(data,null,2)
);

}



export default async function showder(
sock,
from,
body,
m,
args
){


if(m.key.participant && m.key.participant !== OWNER &&
from !== OWNER){

return sock.sendMessage(
from,
{
text:"❌ فقط مالک ربات اجازه دارد."
},
{
quoted:m
}
);

}



const sub =
args[0]?.toLowerCase();



const data = load();



switch(sub){


case "on":

data._status = true;

save(data);


await sock.sendMessage(
from,
{
text:"✅ Showder فعال شد."
},
{
quoted:m
}
);

break;



case "off":

data._status = false;

save(data);


await sock.sendMessage(
from,
{
text:"⛔ Showder خاموش شد."
},
{
quoted:m
}
);

break;



case "status":


await sock.sendMessage(
from,
{
text:
data._status !== false
?
"🟢 Showder روشن است"
:
"🔴 Showder خاموش است"
},
{
quoted:m
}
);


break;



case "list":


await sock.sendMessage(
from,
{
text:
JSON.stringify(data,null,2).slice(0,4000)
},
{
quoted:m
}
);


break;



case "clear":


save({
private:{},
group:{},
_status:true
});


await sock.sendMessage(
from,
{
text:"🗑️ حافظه Showder پاک شد."
},
{
quoted:m
}
);


break;



default:


await sock.sendMessage(
from,
{
text:
`🧠 Showder Menu

!showder on
!showder off
!showder status
!showder list
!showder clear`
},
{
quoted:m
}
);


}



}