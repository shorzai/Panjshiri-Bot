import fetch from "node-fetch";

export default async function ai(
  sock,
  from,
  body,
  m,
  args
) {

  try {

    const q = args.join(" ").trim();

    if (!q) {

      return await sock.sendMessage(from, {
        text: "📌 مثال:\n!ai سلام"
      });

    }

    // start reaction
    try {
      await sock.sendMessage(from, {
        react: {
          text: "🤖",
          key: m.key
        }
      });
    } catch {}

    // timeout
    const controller = new AbortController();

    const timeout = setTimeout(() => {
      controller.abort();
    }, 30000);

    // request
    const response = await fetch(
      "https://api.affiliateplus.xyz/api/chatbot",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          inputs: q
        }),
        signal: controller.signal
      }
    );

    clearTimeout(timeout);

    // check status
    if (!response.ok) {

      return await sock.sendMessage(from, {
        text: `❌ API Error: ${response.status}`
      });

    }

    // raw response
    const raw = await response.text();

    console.log("RAW:", raw);

    // parse safely
    let data;

    try {

      data = JSON.parse(raw);

    } catch {

      return await sock.sendMessage(from, {
        text: "❌ جواب API خراب است"
      });

    }

    // loading
    if (
      data?.error &&
      data.error.toLowerCase().includes("loading")
    ) {

      return await sock.sendMessage(from, {
        text: "⏳ AI هنوز روشن نشده\nچند ثانیه بعد دوباره امتحان کن"
      });

    }

    // answer
    let answer =
      data?.[0]?.generated_text ||
      data?.generated_text ||
      data?.answer ||
      null;

    // empty answer
    if (!answer) {

      return await sock.sendMessage(from, {
        text: "❌ جواب پیدا نشد"
      });

    }

    // limit message size
    if (answer.length > 4000) {
      answer = answer.slice(0, 4000);
    }

    // send answer
    await sock.sendMessage(from, {
      text: `🤖 AI:\n\n${answer}`
    });

    // done reaction
    try {

      await sock.sendMessage(from, {
        react: {
          text: "✅",
          key: m.key
        }
      });

    } catch {}

  } catch (e) {

    console.log("AI ERROR:", e);

    // timeout error
    if (e.name === "AbortError") {

      return await sock.sendMessage(from, {
        text: "⏰ زمان درخواست تمام شد"
      });

    }

    // network error
    if (
      e.code === "ENOTFOUND" ||
      e.code === "ECONNRESET"
    ) {

      return await sock.sendMessage(from, {
        text: "🌐 مشکل اینترنت یا API"
      });

    }

    // unknown error
    await sock.sendMessage(from, {
      text: "❌ AI command error"
    });

  }

}