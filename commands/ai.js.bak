import fetch from "node-fetch";

const GEMINI_API_KEY = "AQ.Ab8RN6JwjK5bQb5CMf68me5wo55g8UfZt_syLwwcDdL2_sw_QA";
const GEMINI_MODEL = "gemini-3.5-flash-lite";

const sleep = (ms) => new Promise(r => setTimeout(r, ms));

export default async function ai(sock, from, body, m, args) {

  try {

    console.log("AI COMMAND STARTED");

    const q = args.join(" ").trim();

    if (!q) {
      return sock.sendMessage(from, {
        text: "📌 مثال:\n!ai سلام"
      });
    }

    try {
      await sock.sendMessage(from, {
        react: { text: "🤖", key: m.key }
      });
    } catch {}

    await sock.sendPresenceUpdate("composing", from);

    await sleep(500);

    const url =
      `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${GEMINI_API_KEY}`;


    const response = await fetch(url, {

      method: "POST",

      headers: {
        "Content-Type": "application/json"
      },

      body: JSON.stringify({

        contents: [
          {
            parts: [
              {
                text: q
              }
            ]
          }
        ],

        generationConfig: {
          temperature: 0.7,
          maxOutputTokens: 2048
        }

      })

    });


    const data = await response.json();


    if (!response.ok) {

      console.log("GEMINI ERROR:", data);

      return sock.sendMessage(from,{
        text:`❌ Gemini Error\n${data?.error?.message || response.status}`
      });

    }


    let answer =
      data?.candidates?.[0]?.content?.parts?.[0]?.text;


    if (!answer) {

      return sock.sendMessage(from,{
        text:"❌ AI جواب نداد"
      });

    }


    if (answer.length > 4000) {
      answer = answer.slice(0,4000);
    }


    await sock.sendMessage(from,{
      text:`🤖 GEMINI AI

${answer}`
    });


    try {
      await sock.sendMessage(from,{
        react:{
          text:"✅",
          key:m.key
        }
      });
    } catch {}


  } catch(e) {

    console.log("AI ERROR:", e);

    await sock.sendMessage(from,{
      text:"❌ خطا در اجرای AI"
    });

  }

}