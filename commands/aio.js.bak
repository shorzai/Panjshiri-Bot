import fetch from "node-fetch";
import { fileTypeFromBuffer } from "file-type";

export default async function aio(sock, from, body, m, args) {
  try {
    const url = args.join(" ").trim();

    if (!url) {
      return sock.sendMessage(from, {
        text: "📌 مثال:\n!aio لینک"
      });
    }

    // ارسال ری‌اکشن لودینگ
    await sock.sendMessage(from, {
      react: {
        text: "⏳",
        key: m.key
      }
    });

    const res = await fetch(
      "https://social-download-all-in-one.p.rapidapi.com/v1/social/autolink", // <--- آدرس اصلاح شد
      {
        method: "POST",
        headers: {
          "accept": "application/json",
          "content-type": "application/json; charset=utf-8",
          "x-rapidapi-host": "social-download-all-in-one.p.rapidapi.com", // <--- هاست اصلاح شد
          "x-rapidapi-key": "57862c7befmsh6c4cd6f9df3427bp1f1bdajsna23f013a136f" // <--- کلید خود را اینجا قرار دهید
        },
        body: JSON.stringify({ url: url })
      }
    );

    if (!res.ok) {
      throw new Error(`RapidAPI Error (Status: ${res.status})`);
    }

    const json = await res.json();
    console.log("AIO RESPONSE:", JSON.stringify(json, null, 2));

    if (json.message && !json.medias) {
      throw new Error(`API Response: ${json.message}`);
    }

    let medias =
      json?.medias ||
      json?.data?.medias ||
      json?.result?.medias ||
      json?.result?.links ||
      json?.links ||
      [];

    if (!Array.isArray(medias)) {
      medias = Object.values(medias || {});
    }

    if (!medias.length) {
      throw new Error("رسانه‌ای از این لینک توسط API یافت نشد.");
    }

    // جداسازی رسانه‌ها
    let video = medias.find(v => JSON.stringify(v).toLowerCase().includes("video"));
    let audio = medias.find(v => JSON.stringify(v).toLowerCase().includes("audio"));
    let image = medias.find(v => JSON.stringify(v).toLowerCase().includes("image"));

    // ارسال ویدیو
    if (video) {
      const videoLink = video.url || video.link || video.download;
      if (videoLink) {
        const r = await fetch(videoLink);
        if (!r.ok) throw new Error("خطا در دانلود فایل ویدیو از سرور اصلی");
        
        const buffer = r.buffer ? await r.buffer() : Buffer.from(await r.arrayBuffer());
        const type = await fileTypeFromBuffer(buffer);

        return sock.sendMessage(from, {
          video: buffer,
          mimetype: type?.mime || "video/mp4",
          caption: "🎯 ALL IN ONE DOWNLOADER\n\n🤖 SULTAN BUG BOT"
        }, { quoted: m });
      }
    }

    // ارسال صدا
    if (audio) {
      const audioLink = audio.url || audio.link || audio.download;
      if (audioLink) {
        const r = await fetch(audioLink);
        if (!r.ok) throw new Error("خطا در دانلود فایل صوتی از سرور اصلی");
        
        const buffer = r.buffer ? await r.buffer() : Buffer.from(await r.arrayBuffer());

        return sock.sendMessage(from, {
          audio: buffer,
          mimetype: "audio/mpeg"
        }, { quoted: m });
      }
    }

    // ارسال عکس
    if (image) {
      const imageLink = image.url || image.link || image.download;
      if (imageLink) {
        return sock.sendMessage(from, {
          image: { url: imageLink },
          caption: "🖼️ Downloaded\n🤖 SULTAN BUG BOT"
        }, { quoted: m });
      }
    }

    throw new Error("هیچ لینک دانلود معتبری در اطلاعات دریافتی یافت نشد.");

  } catch (e) {
    console.error("AIO ERROR:", e);
    await sock.sendMessage(from, {
      text: `❌ خطا در دانلود یا ارسال فایل:\n📌 دلیل: ${e.message || e}`
    });
  }
}