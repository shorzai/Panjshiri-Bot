import fetch from "node-fetch";


const memory = new Map();


export default async function smart(
sock,
from,
body,
m,
args
){


try{


const text =
(body || "").toLowerCase().trim();


if(!text) return;



try{

await sock.sendMessage(from,{
react:{
text:"🧠",
key:m.key
}
});

}catch{}




// سلام

const greetings = [
"سلام",
"hi",
"hello",
"hey",
"salam",
"صبح بخیر",
"شب بخیر"
];


if(greetings.some(x=>text.includes(x))){

return sock.sendMessage(from,{
text:
"👋 سلام دوست عزیز\n🤖 Smart Assistant آماده خدمت است."
});

}





// حال

if(
text.includes("خوبی") ||
text.includes("حالت")
){

return sock.sendMessage(from,{
text:
"😊 من خوبم و آنلاین هستم.\nتو چطوری؟"
});

}





// تشکر

if(
text.includes("تشکر") ||
text.includes("ممنون")
){

return sock.sendMessage(from,{
text:
"❤️ خواهش می‌کنم، همیشه در خدمتم."
});

}





// معرفی

if(
text.includes("کی هستی") ||
text.includes("ربات")
){

return sock.sendMessage(from,{
text:
`
🤖 SULTAN SMART ASSISTANT

🧠 سیستم:
Hybrid AI

🟢 Status:
Online

⚡ Ready To Help
`
});

}





// ساعت

if(
text.includes("ساعت")
){

const time =
new Date().toLocaleTimeString();


return sock.sendMessage(from,{
text:
`⏰ ساعت فعلی:
${time}`
});

}





// ذخیره آخرین پیام

memory.set(from,text);





// AI fallback

try{


const res =
await fetch(
"https://api.simsimi.vn/v2/simtalk",
{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({
inputs:text
})

});


if(res.ok){

const data =
await res.json();


const answer =
data?.message ||
data?.answer ||
data?.response;


if(answer){

return sock.sendMessage(from,{
text:
`🤖 ${answer}`
});

}


}



}catch{}





return sock.sendMessage(from,{
text:
"🤔 هنوز جواب این را یاد نگرفته‌ام، اما دارم بهتر می‌شوم."
});



}catch(e){


console.log(
"SMART ERROR:",
e
);


await sock.sendMessage(from,{
text:
"❌ Smart Assistant Error"
});


}


}