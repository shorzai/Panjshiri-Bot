import { getDB, saveDB } from "../lib/db.js";

export default async function anticallCommand(sock, from, body){

const db = getDB();

db.settings ??= {};
db.settings.global ??= {};

const cmd = body.trim().toLowerCase();


// فعال کردن
if(cmd === "!anticall on"){

db.settings.global.anticall = true;

saveDB(db);

return sock.sendMessage(from,{
text:
"✅ AntiCall فعال شد\n\n📞 تمام تماس‌های ورودی با ربات مسدود می‌شوند."
});

}


// خاموش کردن
if(cmd === "!anticall off"){

db.settings.global.anticall = false;

saveDB(db);

return sock.sendMessage(from,{
text:
"❌ AntiCall خاموش شد"
});

}


// وضعیت
if(cmd === "!anticall"){

return sock.sendMessage(from,{
text:
`
📞 AntiCall Status

وضعیت:
${
db.settings.global.anticall
?
"🟢 فعال"
:
"🔴 خاموش"
}

دستورات:

!anticall on
!anticall off
`
});

}

}