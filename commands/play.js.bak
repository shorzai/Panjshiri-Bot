const API_KEY = "freekey";

const SEARCH_API = "https://pro-apis.zone.id/api/search/yts";
const DOWNLOAD_API = "https://pro-apis.zone.id/api/download/yt";

async function fetchJSON(url) {
    const res = await fetch(url, {
        headers: { "x-api-key": API_KEY },
        signal: AbortSignal.timeout(60000)
    });

    if (!res.ok) {
        throw new Error(`API Error: ${res.status}`);
    }

    return await res.json();
}

function isYouTubeLink(text) {
    try {
        const url = new URL(text);
        return (
            url.hostname.includes("youtube.com") ||
            url.hostname.includes("youtu.be")
        );
    } catch {
        return false;
    }
}

export default async function play(sock, from, body, m, args) {
    try {
        const query = args.join(" ").trim();

        if (!query) {
            return await sock.sendMessage(from, {
                text:
                    "🎵 *RAEES SULTAN MUSIC DOWNLOADER*\n\n" +
                    "روش استفاده:\n\n" +
                    "1️⃣ !play نام آهنگ\n" +
                    "2️⃣ !play نام خواننده\n" +
                    "3️⃣ !play لینک یوتیوب\n\n" +
                    "مثال:\n" +
                    "!play اهنگ ایرانی غمگین"
            }, { quoted: m });
        }

        await sock.sendMessage(from, {
            text: "🔎 در حال جست‌وجوی آهنگ..."
        }, { quoted: m });

        let videoUrl = query;
        let song = {};

        // اگر لینک یوتیوب بود، مستقیماً دانلود کن
        if (!isYouTubeLink(query)) {
            const searchURL = new URL(SEARCH_API);

            searchURL.searchParams.set("key", API_KEY);
            searchURL.searchParams.set("q", query);
            searchURL.searchParams.set("limit", "1");

            const searchData = await fetchJSON(searchURL.toString());

            if (!searchData.success) {
                throw new Error("جست‌وجوی آهنگ موفق نشد.");
            }

            const results = searchData.data?.results || [];

            if (!results.length) {
                throw new Error("آهنگی پیدا نشد.");
            }

            song = results[0];
            videoUrl = song.url;

            if (!videoUrl) {
                throw new Error("لینک آهنگ پیدا نشد.");
            }
        }

        await sock.sendMessage(from, {
            text:
                "⬇️ *در حال دانلود آهنگ...*\n\n" +
                (song.title ? `🎵 ${song.title}\n` : "") +
                (song.author ? `👤 ${song.author}\n` : "") +
                "لطفاً منتظر بمانید..."
        }, { quoted: m });

        const downloadURL = new URL(DOWNLOAD_API);

        downloadURL.searchParams.set("key", API_KEY);
        downloadURL.searchParams.set("url", videoUrl);
        downloadURL.searchParams.set("type", "mp3");
        downloadURL.searchParams.set("quality", "128");

        const downloadData = await fetchJSON(downloadURL.toString());

        if (!downloadData.success) {
            throw new Error(
                downloadData.error || "دانلود آهنگ ناموفق بود."
            );
        }

        const data = downloadData.data;
        const fileURL = data?.downloadUrl;

        if (!fileURL) {
            throw new Error("لینک فایل MP3 دریافت نشد.");
        }

        const audioResponse = await fetch(fileURL, {
            signal: AbortSignal.timeout(120000)
        });

        if (!audioResponse.ok) {
            throw new Error("دریافت فایل صوتی ناموفق بود.");
        }

        const maxSize = 25 * 1024 * 1024;
        const audioBuffer = Buffer.from(
            await audioResponse.arrayBuffer()
        );

        if (!audioBuffer.length) {
            throw new Error("فایل آهنگ خالی است.");
        }

        if (audioBuffer.length > maxSize) {
            throw new Error("حجم آهنگ بیشتر از 25MB است.");
        }

        const title = data.title || song.title || "Music";

        const safeName = title
            .replace(/[\\/:*?"<>|]/g, "")
            .slice(0, 100);

        await sock.sendMessage(from, {
            audio: audioBuffer,
            mimetype: "audio/mpeg",
            fileName: `${safeName}.mp3`,
            ptt: false
        }, { quoted: m });

        console.log("PLAY SUCCESS:", title);

    } catch (error) {
        console.log("PLAY ERROR:", error);

        await sock.sendMessage(from, {
            text:
                "❌ دانلود آهنگ انجام نشد.\n\n" +
                `خطا: ${error.message}`
        }, { quoted: m });
    }
}