  import axios from "axios";

export default async function ai(sock, from, body, m, args) {
  try {
    const apiKey = process.env.HCN_API_KEY;

    if (!apiKey) {
      return sock.sendMessage(from, {
        text: "❌ API Key تنظیم نشده است."
      });
    }

    const prompt = args?.join(" ").trim();

    if (!prompt) {
      return sock.sendMessage(from, {
        text: "🤖 مثال:\n!ai سلام، خودت را معرفی کن"
      });
    }

    await sock.sendMessage(from, {
      text: "🤖 در حال فکر کردن..."
    });

    const response = await axios.post(
      "https://api.hcnsec.cn/v1/chat/completions",
      {
        model: "glm-4-5",
        messages: [
          {
            role: "system",
            content: "You are a helpful WhatsApp bot. Answer clearly and concisely."
          },
          {
            role: "user",
            content: prompt
          }
        ]
      },
      {
        headers: {
          Authorization: `Bearer ${apiKey}`,
          "Content-Type": "application/json"
        },
        timeout: 60000
      }
    );

    const answer =
      response.data?.choices?.[0]?.message?.content ||
      response.data?.choices?.[0]?.text;

    if (!answer) {
      console.log("HCN API RESPONSE:", response.data);

      return sock.sendMessage(from, {
        text: "❌ API پاسخ قابل استفاده‌ای برنگرداند."
      });
    }

    await sock.sendMessage(from, {
      text: `🤖 AI:\n\n${answer}`
    });

  } catch (error) {
    console.error(
      "AI ERROR:",
      error.response?.data || error.message
    );

    const apiError =
      error.response?.data?.error?.message ||
      error.response?.data?.message;

    await sock.sendMessage(from, {
      text: apiError
        ? `❌ خطای API:\n${apiError}`
        : "❌ اتصال به سرویس AI ناموفق بود."
    });
  }
}







