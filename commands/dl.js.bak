import axios from 'axios'; // مطمئن شوید axios در package.json نصب است

export default async function downloader(sock, from, body, m, args) {
    try {
        // گرفتن لینک از آرگومان‌ها (مثال: !dl https://youtube.com/...)
        const url = args[0];

        if (!url) {
            await sock.sendMessage(from, { 
                text: "Usage: !dl [Link]\nExample: !dl https://www.youtube.com/watch?v=..." 
            });
            return;
        }

        // تشخیص نوع پلتفرم بر اساس URL
        let platform = '';
        if (url.includes('facebook') || url.includes('fb.watch')) platform = 'facebook';
        else if (url.includes('instagram') || url.includes('instagr.am')) platform = 'instagram';
        else if (url.includes('youtube') || url.includes('youtu.be')) platform = 'youtube';
        else if (url.includes('tiktok') || url.includes('vm.tiktok')) platform = 'tiktok';

        if (!platform) {
            await sock.sendMessage(from, { text: "Platform not supported. Supported: Facebook, Instagram, YouTube, TikTok." });
            return;
        }

        // ارسال پیام شروع دانلود
        await sock.sendMessage(from, { text: `Downloading from ${platform}... Please wait.` });

        let mediaUrl = '';
        let type = 'video'; // پیش‌فرض ویدیو، ممکن است عکس باشد

        // --- منطق دانلود بر اساس پلتفرم ---
        // نکته: برای دقت بالاتر می‌توان از APIهای عمومی یا اسکریپت‌های Node.js خاص استفاده کرد.
        // در اینجا از یک روش عمومی با استفاده از Axios و Parse کردن لینک‌ها استفاده می‌کنیم.

        if (platform === 'youtube') {
            // برای یوتیوب، معمولاً نیاز به API داریم. 
            // اینجا یک مثال ساده با استفاده از سرویس‌های عمومی یا استخراج لینک مستقیم ارائه می‌دهیم.
            // برای سادگی، فرض می‌کنیم لینک مستقیم ویدیو را داریم یا از یک endpoint عمومی استفاده می‌کنیم.
            // *نکته: برای یوتیوب واقعی، بهتر است از کتابخانه 'yt-dlp' یا APIهایی مثل RapidAPI استفاده کنید.*
            // اینجا یک نمونه کد با فرض استفاده از یک سرویس رایگان عمومی (ممکن است تغییر کند) نوشته شده است:
            
            // اگر می‌خواهید دقیق کار کند، پیشنهاد می‌کنم از APIهای آنلاین استفاده کنید. 
            // فعلاً یک شبیه‌سازی هوشمند انجام می‌دهیم:
            mediaUrl = await getYouTubeDirectLink(url); 

        } else if (platform === 'instagram') {
            // اینستاگرام کمی پیچیده است به دلیل CORS و تغییرات API.
            // ما از یک سرویس عمومی برای استخراج لینک استفاده می‌کنیم.
            mediaUrl = await getInstagramLink(url);

        } else if (platform === 'tiktok') {
            // تیک‌تاچ معمولاً لینک مستقیم ویدیو را در HTML یا API برمی‌گرداند.
            mediaUrl = await getTikTokLink(url);

        } else if (platform === 'facebook') {
            // فیس‌بوک نیز نیاز به استخراج لینک دارد.
            mediaUrl = await getFacebookLink(url);
        }

        if (!mediaUrl) {
            await sock.sendMessage(from, { text: "Failed to extract download link." });
            return;
        }

        // دانلود فایل از لینک به دست آمده
        const response = await axios.get(mediaUrl, { responseType: 'arraybuffer' });
        const buffer = Buffer.from(response.data);

        // تعیین نوع محتوا (MIME Type)
        let mimetype = response.headers['content-type'] || 'video/mp4';
        
        // اگر لینک با png یا jpg تمام می‌شود، عکس است
        if (mediaUrl.endsWith('.png') || mediaUrl.endsWith('.jpg')) {
            type = 'image';
            mimetype = 'image/jpeg';
        }

        // ارسال فایل به کاربر در واتساپ
        await sock.sendMessage(from, { 
            [type]: buffer, 
            mimetype: mimetype,
            caption: `Downloaded from ${platform}!`
        });

    } catch (error) {
        console.error("DOWNLOADER ERROR:", error);
        await sock.sendMessage(from, { text: `Error: ${error.message}` });
    }
}

// --- توابع کمکی برای استخراج لینک‌ها ---

async function getYouTubeDirectLink(url) {
    // استفاده از یک سرویس عمومی یا API رایگان (ممکن است نیاز به آپدیت داشته باشد)
    // در محیط واقعی، پیشنهاد می‌شود از yt-dlp یا APIهای پولی استفاده کنید.
    // اینجا برای سادگی، فرض می‌کنیم لینک مستقیم را داریم یا از یک endpoint عمومی استفاده می‌کنیم.
    // *نکته: این بخش ممکن است نیاز به تنظیمات CORS یا Proxy داشته باشد.*
    
    // مثال ساده: اگر کاربر لینک embed بدهد، ما آن را تبدیل نمی‌کنیم، فقط لینک اصلی را برمی‌گردانیم.
    // برای یک دانلودر واقعی یوتیوب در واتساپ بات، بهتر است از سرویس‌هایی مثل 'yt-api' استفاده کنید.
    
    // شبیه‌سازی: بازگرداندن خود لینک (اگر API خاصی ندارید)
    // در عمل، شما باید این URL را به یک سرویس تبدیل ویدیو بفرستید.
    return url; // *این فقط برای تست است. برای عملکرد واقعی، نیاز به API دارید.*
}

async function getInstagramLink(url) {
    // اینستاگرام معمولاً لینک مستقیم ندارد. ما از یک سرویس عمومی استفاده می‌کنیم.
    try {
        const res = await axios.get(`https://api.instagram.com/oembed/?url=${encodeURIComponent(url)}`);
        // این روش ساده است، اما برای دانلود فایل اصلی نیاز به اسکراپینگ پیچیده‌تر داریم.
        // برای سادگی کد، فرض می‌کنیم لینک پست را دارید.
        return url; 
    } catch (e) {
        throw new Error("Instagram link extraction failed");
    }
}

async function getTikTokLink(url) {
    // تیک‌تاچ: استخراج لینک مستقیم از API عمومی
    try {
        const res = await axios.get(`https://api.tiktokv.com/aweme/v1/play/?video_id=${url.split('/').pop()}&ratio=720p&line=0`);
        return res.data.play_addr.url;
    } catch (e) {
        throw new Error("TikTok link extraction failed");
    }
}

async function getFacebookLink(url) {
    // فیس‌بوک: مشابه اینستاگرام، نیاز به API دارد.
    return url;
}