// commands/listonline.js

export default async function listonline(sock, from){

try{


if(!from.endsWith("@g.us")){

return sock.sendMessage(from,{
text:"❌ فقط داخل گروه کار می‌کند"
});

}



const meta =
await sock.groupMetadata(from);



const members =
meta.participants.map(
p=>p.id
);



const online =
Object.keys(
sock.presence?.[from] || {}
);



const users =
online.filter(
u=>members.includes(u)
);



let text =
`
╭━━━〔 🟢 ONLINE USERS 〕━━━╮

📌 گروه:
${meta.subject}

👥 آنلاین:
${users.length}

━━━━━━━━━━━━

`;



if(users.length === 0){

text +=
"❌ هیچ کاربر آنلاینی پیدا نشد\n";

}else{


for(let i=0;i<users.length;i++){


const id =
users[i];


const member =
meta.participants.find(
p=>p.id===id
);


const name =
member?.notify ||
id.split("@")[0];



const status =
sock.presence?.[from]?.[id]?.lastKnownPresence ||
"available";



text +=
`
${i+1}️⃣ 🟢 ${name}

📱 @${id.split("@")[0]}

📡 وضعیت:
${status}

━━━━━━━━━━━━
`;

}


}



text +=
`
🤖 RAEES SULTAN BOT
⚡ Live Presence System
`;



await sock.sendMessage(from,{

text,

mentions:users

});



}catch(e){

console.log(
"LISTONLINE ERROR:",
e
);


await sock.sendMessage(from,{
text:"❌ خطا در گرفتن کاربران آنلاین"
});

}


}