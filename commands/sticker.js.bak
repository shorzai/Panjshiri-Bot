import sharp from "sharp";
import ffmpeg from "fluent-ffmpeg";
import fs from "fs";
import path from "path";


export default async function sticker(sock, from, m){


try{


const quoted =
m.message?.extendedTextMessage?.contextInfo?.quotedMessage;



if(!quoted){

return sock.sendMessage(from,{
text:
"📌 یک عکس یا ویدیو را ریپلای کن و بنویس !sticker"
});

}




let type = "";


if(quoted.imageMessage){

type = "image";

}


else if(quoted.videoMessage){

type = "video";

}


else{


return sock.sendMessage(from,{
text:
"❌ فقط عکس یا ویدیو پشتیبانی می‌شود"
});

}



const buffer =
await sock.downloadMediaMessage({
message: quoted
});



const id =
Date.now();



const input =
`./temp_${id}`;

const output =
`./sticker_${id}.webp`;



fs.writeFileSync(
input,
buffer
);



if(type === "image"){


await sharp(input)
.resize(512,512,{
fit:"contain"
})
.webp({
quality:80
})
.toFile(output);



}else{


await new Promise((resolve,reject)=>{


ffmpeg(input)

.outputOptions([
"-vcodec libwebp",
"-vf scale=512:512:force_original_aspect_ratio=decrease",
"-loop 0",
"-preset default"
])

.save(output)

.on("end",resolve)

.on("error",reject);



});


}



await sock.sendMessage(from,{

sticker:{
url:output
}

});



fs.unlinkSync(input);

fs.unlinkSync(output);



}catch(e){

console.log(
"STICKER ERROR:",
e
);


await sock.sendMessage(from,{
text:
"❌ ساخت استیکر ناموفق بود"
});


}


}