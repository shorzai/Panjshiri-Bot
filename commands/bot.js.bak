`;

            if (fs.existsSync("./menu.mp4")) {
                await sock.sendMessage(from, { video: { url: "./menu.mp4" }, caption: menuText });
            } else {
                await sock.sendMessage(from, { text: menuText });
            }
        }

    });
}

