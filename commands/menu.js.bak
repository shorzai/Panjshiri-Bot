        attrs: {
          source_type: "third_party"
        }
      }
    ]
  };

  const additionalNodes = isJidGroup(from)
    ? [bizNode]
    : [
        {
          tag: "bot",
          attrs: {
            biz_bot: "1"
          }
        },
        bizNode
      ];

  await sock.relayMessage(
    from,
    waMessage.message,
    {
      messageId: waMessage.key.id,
      additionalNodes
    }
  );

