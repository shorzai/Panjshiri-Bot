import anticall from "./lib/anticall.js";
import { checkAntilink } from "./commands/antilink.js";
import capsuleRunner from "./lib/capsule.js";
import spy from "./lib/spy.js";

let reconnecting = false;

// 🔥 Lion Banner
console.log(chalk.red.bold(`
