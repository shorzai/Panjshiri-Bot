// گرفتن ورودی از کاربر (شماره)
const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout
});

function question(text) {
  return new Promise((resolve) => rl.question(text, resolve));
}

async function start() {
  const { state, saveCreds } = await useMultiFileAuthState("./session");
  const { version } = await fetchLatestBaileysVersion();

  const sock = makeWASocket({
    auth: state,
    version,
    logger: Pino({ level: "silent" }),
    browser: ["Ubuntu", "Chrome", "120.0.0"],
    printQRInTerminal: false
  });

  sock.ev.on("creds.update", saveCreds);

// AUTO SYSTEMS

shadow(sock);

welcome(sock);

goodbye(sock);

typing(sock);

autoread(sock);

anticall(sock);

capsuleRunner(sock);

spy(sock);

console.log(
  chalk.green.bold("✅ ALL AUTO SYSTEMS STARTED")
);

  sock.ev.on("connection.update", async (update) => {
    const { connection, lastDisconnect, pairingCode } = update;

    console.log("STATE:", connection);

    if (pairingCode) {
      console.log(chalk.cyan.bold("\n🔑 YOUR PAIRING CODE:"));
      console.log(chalk.green.bold("👉 " + pairingCode));
      console.log(chalk.yellow(`
📱 Open WhatsApp:
Linked devices > Link with phone number > Enter code
`));
    }

   if (connection === "open") {
  reconnecting = false;

  console.log(chalk.green.bold("✔️ CONNECTED SUCCESSFULLY"));

  await notifyOwner(sock);
}
    if (connection === "close") {
      const code = lastDisconnect?.error?.output?.statusCode;

      const shouldReconnect = code !== DisconnectReason.loggedOut;

      if (!shouldReconnect) {
        console.log(chalk.red.bold("❌ LOGGED OUT"));
        return;
      }

      if (reconnecting) return;
      reconnecting = true;

      console.log(chalk.yellow.bold("♻️ reconnecting..."));

      setTimeout(() => {
        reconnecting = false;
        start();
      }, 4000);
    }
  });

  sock.ev.on("messages.upsert", async ({ messages }) => {
    try {
      const m = messages[0];
      if (!m?.message) return;

      const from = m.key.remoteJid;

      const body =
        m.message.conversation ||
        m.message.extendedTextMessage?.text ||
        "";

      await handler(sock, from, body, m);
    } catch (e) {
      console.log("MSG ERROR:", e);
    }
  });

  const phone = await question(chalk.blue.bold("📞 ENTER YOUR WHATSAPP NUMBER: "));
  rl.close();

  try {
    const code = await sock.requestPairingCode(phone);
    console.log(chalk.green.bold("\n🔑 Pairing Code: " + code));
  } catch (e) {
    console.log(chalk.red.bold("❌ Error generating code:"), e);
  }
}

process.on("uncaughtException", console.log);
process.on("unhandledRejection", console.log);

start();