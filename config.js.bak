import { db } from "./db.js";

const getSafe = (path, fallback) => {
  try {
    return path?.() ?? fallback;
  } catch {
    return fallback;
  }
};

export default {

  // =====================
  // BOT SETTINGS
  // =====================

  get PREFIX() {
    return getSafe(() => db.data.settings.prefix, ".");
  },


  get OWNER() {
    return getSafe(() => db.data.settings.owner, "");
  },


  MODE: "public",


